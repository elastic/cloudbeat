{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>elastic/renovate-config"
  ],
  "baseBranchPatterns": [
    "main",
    "9.5",
    "9.4",
    "8.19"
  ],
  "schedule": [
    "* 1 * * 1-5"
  ],
  "automergeSchedule": [
    "at any time"
  ],
  "labels": [
    "renovate",
    "dependencies",
    "Team:Security-Cloud Services",
    "backport-skip"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "separateMajorMinor": true,
  "prConcurrentLimit": 50,
  "prHourlyLimit": 10,
  "automergeStrategy": "squash",
  "automergeType": "pr",
  "ignorePaths": [
    "**/vendor/**"
  ],
  "enabledManagers": [
    "buildkite",
    "dockerfile",
    "github-actions",
    "gomod",
    "helm-values",
    "hermit",
    "kustomize",
    "poetry",
    "pre-commit",
    "terraform"
  ],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "description": "Update .go-version file",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.go-version$/"
      ],
      "matchStrings": [
        "(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s"
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    },
    {
      "description": "Update :go-version: in docs/version.asciidoc",
      "customType": "regex",
      "managerFilePatterns": [
        "/^docs/version\\.asciidoc$/"
      ],
      "matchStrings": [
        ":go-version: (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version"
    }
  ],
  "packageRules": [
    {
      "description": "Ignore elastic/beats v7 - requires manual update",
      "matchPackageNames": [
        "github.com/elastic/beats/v7"
      ],
      "enabled": false
    },
    {
      "description": "Group AWS SDK packages together",
      "groupName": "aws-sdk",
      "matchPackageNames": [
        "github.com/aws/aws-sdk-go-v2",
        "github.com/aws/aws-sdk-go-v2/**"
      ]
    },
    {
      "description": "Group Azure SDK packages together",
      "groupName": "azure-sdk",
      "matchPackageNames": [
        "github.com/Azure/azure-sdk-for-go/**"
      ]
    },
    {
      "description": "Group GCP packages together",
      "groupName": "gcp-sdk",
      "matchPackageNames": [
        "cloud.google.com/go/**"
      ]
    },
    {
      "description": "Group Kubernetes packages together",
      "groupName": "k8s",
      "matchPackageNames": [
        "k8s.io/api",
        "k8s.io/apimachinery",
        "k8s.io/client-go",
        "k8s.io/kubectl"
      ]
    },
    {
      "description": "Group golang.org/x packages together",
      "groupName": "golang.org/x",
      "matchPackageNames": [
        "golang.org/x/**"
      ]
    },
    {
      "description": "Group Elastic packages together",
      "groupName": "elastic",
      "matchPackageNames": [
        "github.com/elastic/**"
      ]
    },
    {
      "description": "Group Trivy packages together",
      "groupName": "trivy",
      "matchPackageNames": [
        "github.com/aquasecurity/trivy",
        "github.com/aquasecurity/trivy-db",
        "github.com/aquasecurity/go-dep-parser"
      ]
    },
    {
      "description": "Group google.golang.org/genproto packages together",
      "groupName": "google-genproto",
      "matchPackageNames": [
        "google.golang.org/genproto",
        "google.golang.org/genproto/**"
      ]
    },
    {
      "description": "Group OpenTelemetry packages together",
      "groupName": "opentelemetry",
      "matchPackageNames": [
        "go.opentelemetry.io/**"
      ]
    },
    {
      "description": "Group Microsoft Kiota packages together",
      "groupName": "microsoft-kiota",
      "matchPackageNames": [
        "github.com/microsoft/kiota-*"
      ]
    },
    {
      "description": "Group Microsoft Graph SDK packages together",
      "groupName": "microsoft-graph-sdk",
      "matchPackageNames": [
        "github.com/microsoftgraph/**"
      ]
    },
    {
      "description": "Group Kubernetes SIG packages together",
      "groupName": "k8s-sigs",
      "matchPackageNames": [
        "sigs.k8s.io/**"
      ]
    },
    {
      "description": "Group containerd packages together",
      "groupName": "containerd",
      "matchPackageNames": [
        "github.com/containerd/**"
      ]
    },
    {
      "description": "Group Docker packages together",
      "groupName": "docker",
      "matchPackageNames": [
        "github.com/docker/**"
      ]
    },
    {
      "description": "Group Moby packages together",
      "groupName": "moby",
      "matchPackageNames": [
        "github.com/moby/**"
      ]
    },
    {
      "description": "Group Sigstore packages together",
      "groupName": "sigstore",
      "matchPackageNames": [
        "github.com/sigstore/**"
      ]
    },
    {
      "description": "Enable indirect Go dependencies",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "description": "Disable sarama updates - requires manual handling",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "/^github\\.com/elastic/sarama$/"
      ],
      "enabled": false
    },
    {
      "description": "Disable go.mod replace directive updates - pins must match beats go.mod; renovate writes invalid bare commit hashes",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "replace"
      ],
      "enabled": false
    },
    {
      "description": "Disable goja updates - replaced by elastic/goja, version is driven by beats",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/dop251/goja",
        "github.com/dop251/goja_nodejs"
      ],
      "enabled": false
    },
    {
      "description": "Disable e2e-testing updates - v1.99.x tags are not real releases (latest is v1.2.3)",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/elastic/e2e-testing"
      ],
      "enabled": false
    },
    {
      "description": "Disable go-ini/ini updates - v1.67.1+ declares its module path as gopkg.in/ini.v1, so 'go get github.com/go-ini/ini' fails; gopkg.in/ini.v1 is already used by trivy/opa/rekor, only yq still imports the old path. Must stay after the 'Enable indirect Go dependencies' rule, which would otherwise re-enable it",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/go-ini/ini"
      ],
      "enabled": false
    },
    {
      "description": "Disable anchore/go-struct-converter updates - v0.2.x removes converter.ConvertFrom, which spdx/tools-golang (latest v0.5.7) still calls, breaking the build. Re-enable once spdx/tools-golang supports it. Must stay after the 'Enable indirect Go dependencies' rule",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/anchore/go-struct-converter"
      ],
      "enabled": false
    },
    {
      "description": "Disable k8s.io/kube-openapi updates - newer digests require sigs.k8s.io/structured-merge-diff/v7, but k8s.io/apimachinery v0.37.x still uses v6, breaking the build. Re-enable once a stable k8s.io release (v0.38+) moves to v7. Must stay after the 'Enable indirect Go dependencies' rule",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "k8s.io/kube-openapi"
      ],
      "enabled": false
    },
    {
      "description": "Cap OPA below v1.21.0 - v1.21+ requires gobwas/glob v1.0.0, which removes glob.Glob and breaks go.opentelemetry.io/collector/confmap (undefined: glob.Glob). Re-enable once otel confmap migrates (opentelemetry-collector#15928) and beats picks it up. Must stay after the 'Enable indirect Go dependencies' rule",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/open-policy-agent/opa"
      ],
      "allowedVersions": "<1.21.0"
    },
    {
      "description": "Disable otelaws updates - v0.72.0 deprecates the package (staticcheck SA1019); we are in maintenance mode, so stay on v0.71.0. Must stay after the 'Enable indirect Go dependencies' rule",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "go.opentelemetry.io/contrib/instrumentation/github.com/aws/aws-sdk-go-v2/otelaws"
      ],
      "enabled": false
    },
    {
      "description": "Auto-merge minor, patch, digest, and pin updates for all packages",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "addLabels": [
        "renovate-auto-approve"
      ],
      "automerge": true,
      "minimumReleaseAge": "2 days"
    },
    {
      "description": "Manual review for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Disable digest updates for volatile packages",
      "matchPackageNames": [
        "k8s.io/utils",
        "golang.org/x/crypto",
        "golang.org/x/net",
        "golang.org/x/exp",
        "golang.org/x/oauth2"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": false
    },
    {
      "description": "Allow minor Go version updates in go.mod",
      "matchDepNames": [
        "go"
      ],
      "matchManagers": [
        "gomod"
      ],
      "versioning": "semver"
    },
    {
      "description": "Group Go toolchain and golangci-lint version updates together",
      "groupName": "go-version",
      "matchDepNames": [
        "go",
        "golangci-lint"
      ]
    },
    {
      "description": "Group pre-commit hook rev updates into one PR",
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "pre-commit"
    },
    {
      "description": "Disable CI/infrastructure/test-environment updates on release branches",
      "matchBaseBranches": [
        "9.5",
        "9.4",
        "8.19"
      ],
      "matchFileNames": [
        ".github/workflows/**",
        ".buildkite/**",
        "**/pyproject.toml",
        "deploy/test-environments/**",
        ".pre-commit-config.yaml"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "dependencyDashboardReportAbandonment": false
}
